f=\"name === 'select'\">\n+      <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"4\" stroke-width=\"2\" />\n+      <path d=\"m7.5 12 3 3 6-6\" stroke-width=\"2\" />\n+    </template>\n+  selectionMode?: boolean;\n-/** Selection mode: any selected row reveals every row's gutter checkbox. */\n-const selecting = computed(() => selectedKeys.value.size > 0);\n+const selecting = computed(() => !props.readOnly\n+  && (selectedKeys.value.size > 0 || (props.compact && props.selectionMode)));\n-          <strong data-test=\"selection-count\">{{ count }} selected</strong>{{ ' ' }}<span class=\"selection-loaded-scope\" data-test=\"selection-loaded-scope\">· {{ loadedCount }} loaded</span>\n+          <strong v-if=\"count > 0\" data-test=\"selection-count\">{{ count }} of {{ loadedCount }} selected</strong>\n+          <strong v-else>Select conversations</strong>\n-          v-if=\"context !== 'done'\"\n+          v-if=\"count > 0 && context !== 'done'\"\n-          v-if=\"context !== 'inbox'\"\n+          v-if=\"count > 0 && context !== 'inbox'\"\n-          v-if=\"readAvailable\"\n+          v-if=\"count > 0 && readAvailable\"\n-          v-if=\"readAvailable\"\n+          v-if=\"count > 0 && readAvailable\"\n-          :disabled=\"selectAllDisabled\"\n+          :disabled=\"selectAllDisabled || count === loadedCount\"\n-          :aria-label=\"'Select all loaded (' + loadedCount + ')'\"\n+          :aria-label=\"`Select all ${loadedCount} loaded conversations`\"\n-        >Select all ({{ loadedCount }})</button>\n+        >Select {{ loadedCount }} loaded</button>\n+  selectShown?: boolean;\n+const emit = defineEmits<{ select: [] }>();\n+\n+    <button\n+      v-if=\"selectShown\"\n+      type=\"button\"\n+      class=\"mobile-round-button\"\n+      data-test=\"mobile-select\"\n+      aria-label=\"Select conversations\"\n+      @click=\"emit('select')\"\n+    >\n+      <HeaderGlyph name=\"select\" />\n+    </button>\n+  selectionMode: Ref<boolean>;\n-    selectedRefs, ra