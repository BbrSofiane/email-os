here;\n}\n.app[data-layout=\"compact\"] .list-dock .action-notice {\n  align-items: center;\n  justify-content: space-between;\n  gap: 4px 12px;\n}\n.app[data-layout=\"compact\"] .list-dock .action-notice-empty {\n  display: none;\n  min-height: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  box-shadow: none;\n}\n.app[data-layout=\"compact\"] .list-dock kbd {\n  display: none;\n}\n.app[data-layout=\"compact\"] .action-notice-text {\n  flex: 1 1 180px;\n  min-width: 0;\n  flex-wrap: wrap;\n  overflow-wrap: anywhere;\n}\n.app[data-layout=\"compact\"] .action-notice-label,\n.app[data-layout=\"compact\"] .action-notice-status,\n.app[data-layout=\"compact\"] .action-notice-expired {\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n.app[data-layout=\"compact\"] .action-notice-undo {\n  flex: none;\n  margin-left: 0;\n}\n.app[data-layout=\"compact\"] .action-notice-undo button {\n  min-height: 48px;\n  padding: 0 8px;\n  color: var(--focus-accent);\n  font-weight: 600;\n}\n.app[data-layout=\"compact\"] .action-notice-hint {\n  display: none;\n}\n.app[data-layout=\"compact\"] .command-error,\n.app[data-layout=\"compact\"] .reminder-confirmation {\n  display: block;\n  color: var(--danger);\n}\n.app[data-layout=\"compact\"] .reminder-confirmation {\n  color: var(--text-secondary);\n}","stderr":"\nShell cwd was reset to /home/exedev/email-os","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"8af46716-90ef-41cc-b865-777e45633c5f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"t3-code","cwd":"/home/exedev/email-os","sessionId":"415cd333-37f5-4cfe-be88-ad6fe867d94b","version":"2.1.326","gitBranch":"main","slug":"cached-bubbling-meadow"}
