{"parentUuid":"6af51a92-ffbb-407c-b901-8b52c3bd5dec","isSidechain":false,"attachment":{"type":"deferred_tools_record","entries":[{"name":"mcp__t3-code__delegate_task","description":"Start one child agent with only `task`. No parent history. Separate checkout or PR per child: `isolation:'worktree'`. Keep `taskId` for `task_status` and `task_cancel`. No secrets in `task`.","input_schema":{"type":"object","properties":{"task":{"type":"string"},"target":{"type":"object","properties":{"providerInstanceId":{"type":"string"},"driverKind":{"type":"string"},"model":{"type":"string"},"options":{"description":"Options from `orchestrator_capabilities`, such as {effort:'max'}. Given values override inherited. [] or {} clears.","anyOf":[{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"value":{"anyOf":[{"type":"string"},{"type":"boolean"}]}},"required":["id","value"]}},{"type":"object","additionalProperties":{"anyOf":[{"type":"string"},{"type":"boolean"}]}}]},"environmentId":{"type":"string"},"projectId":{"type":"string"}}},"title":{"type":"string"},"role":{"type":"string","enum":["implementation","research","review","design","test","general"]},"isolation":{"type":"string","enum":["shared","worktree"],"description":"'shared' (default): parent checkout. 'worktree': new prepared checkout from the parent commit, for a separate checkout or PR per child. Uncommitted edits stay out."},"mode":{"type":"string","enum":["async","wait"],"description":"Default 'async'. 'wait' only if this turn needs the result. A question or approval ends the wait."},"timeoutMs":{"type":"number","description":"Mode 'wait' only. At most 45 s. A timeout does not cancel the child."},"clientRequestId":{"type":"string"},"runtimeMode":{"type":"string","enum":["inherit","approval-required","auto-accept-edits","auto","full-access"],"description":"Omit unless the user asks for a supervised child. Narrow modes pause for human approval, not read-only. Above yours is rejected."},"interaction