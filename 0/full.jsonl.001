s/mobile/list.css\n+++ b/src/assets/mobile/list.css\n@@ -93,13 +93,12 @@\n   z-index: auto;\n   display: flex;\n   align-items: center;\n-  gap: 12px;\n-  padding-inline: 16px;\n+  gap: 8px;\n+  padding-inline: 12px;\n   top: 0;\n   bottom: 0;\n   width: var(--swipe-distance, 0px);\n   overflow: hidden;\n-  white-space: nowrap;\n   color: var(--text-primary);\n   transition: background-color 120ms ease-out, color 120ms ease-out, transform 120ms ease-out;\n }\n@@ -133,8 +132,9 @@\n \n .app[data-layout=\"compact\"] .row-swipe-icon {\n   display: grid;\n-  width: 40px;\n-  height: 40px;\n+  flex: none;\n+  width: 24px;\n+  height: 24px;\n   place-items: center;\n   background: transparent;\n }\n@@ -149,10 +149,19 @@\n   transform: scale(1.15);\n }\n \n-.app[data-layout=\"compact\"] .row-swipe-underlay.armed > span:last-child {\n+.app[data-layout=\"compact\"] .row-swipe-underlay.armed .row-swipe-label {\n   font-weight: 600;\n }\n \n+.app[data-layout=\"compact\"] .row-swipe-label {\n+  min-width: 0;\n+  overflow-wrap: anywhere;\n+}\n+\n+.app[data-layout=\"compact\"] .row-swipe-underlay:not(.labelled) .row-swipe-label {\n+  display: none;\n+}\n+\n .app[data-layout=\"compact\"] .row-read-state {\n   left: 7.5px;\n   top: 22px;\ndiff --git a/src/assets/mobile/notices.css b/src/assets/mobile/notices.css\nindex 6467917..bbc07a5 100644\n--- a/src/assets/mobile/notices.css\n+++ b/src/assets/mobile/notices.css\n@@ -20,11 +20,12 @@\n   gap: 4px 12px;\n }\n .app[data-layout=\"compact\"] .list-dock .action-notice-empty {\n-  display: none;\n+  position: absolute;\n   min-height: 0;\n   margin: 0;\n   padding: 0;\n   border: 0;\n+  background: transparent;\n   box-shadow: none;\n }\n .app[data-layout=\"compact\"] .list-dock kbd {\ndiff --git a/src/components/ActionNotice.vue b/src/components/ActionNotice.vue\nindex 156ad0d..180af21 100644\n--- a/src/components/ActionNotice.vue\n+++ b/src/components/ActionNotice.vue\n@@ -78,15 +78,20 @@ const props = defineProps<{\n     /** True once this action had an undo window; gates the expired wording. */\n     hadWindow: boolean;\n     /** Set after a successful undo: outcome plus the refreshed compensating rows. */\n-    undone: { outcome: UndoOutcome; compensations: OperationSummaryLike[] } | null;\n+    undone: {\n+      outcome: UndoOutcome;\n+      compensations: OperationSummaryLike[];\n+      expectedCompensations?: number;\n+    } | null;\n     /** Present when the slot holds a bulk group action instead of a single. */\n     group?: GroupNoticeView | null;\n   } | null;\n   /** Advisory wall-clock milliseconds (App-owned timer); the backend decides eligibility. */\n   now: number;\n+  compact?: boolean;\n }>();\n \n-const emit = defineEmits<{ undo: []; undoGroup: []; dismissGroup: [] }>();\n+const emit = defineEmits<{ undo: []; undoGroup: []; dismissGroup: []; openActivity: [] }>();\n \n const isGroup = computed(() => !!props.notice?.group);\n \n@@ -190,6 +195,14 @@ const UNDO_EXPIRED_RECOVERY: Record<LastActionId, string> = {\n   unstar: 'use Star',\n };\n \n+const allCompensationsConfirmed = computed(() => {\n+  const undone = props.notice?.undone;\n+  if (!undone || undone.compensations.length === 0) return false;\n+  if (props.compact && undone.expectedCompensations !== undefined\n+    && undone.compensations.length < undone.expectedCompensations) return false;\n+  return undone.compensations.every((operation) => operation.status === 'confirmed');\n+});\n+\n const statusText = computed(() => {\n   const undone = props.notice?.undone ?? null;\n   if (undone) {\n@@ -197,7 +210,7 @@ const statusText = computed(() => {\n     const statuses = undone.compensations.map((op) => op.status);\n     if (statuses.includes('failed')) return 'Restore failed — see Activity';\n     if (statuses.includes('outcome_unknown')) return 'Restore outcome unknown — see Activity';\n-    if (statuses.length > 0 && statuses.every((status) => status === 'confirmed')) return 'Restored';\n+    if (allCompensationsConfirmed.value) return 'Restored';\n     // Compensations not landed/confirmed yet (or not visible in activity yet).\n     return 'Restoring…';\n   }\n@@ -228,7 +241,7 @@ const statusTone = computed<NoticeStatusTone>(() => {\n     const statuses = undone.compensations.map((op) => op.status);\n     if (statuses.includes('failed')) return 'failed';\n     if (statuses.includes('outcome_unknown')) return 'unknown';\n-    if (statuses.length > 0 && statuses.every((status) => status === 'confirmed')) return 'settled';\n+    if (allCompensationsConfirmed.value) return 'settled';\n     return 'pending';\n   }\n   switch (props.notice?.operation?.status) {\n@@ -251,6 +264,28 @@ const undoVisible = computed(() => {\n   return Date.parse(until) > props.now;\n });\n \n+const showNotice = computed(() => {\n+  const notice = props.notice;\n+  if (!notice || !props.compact) return !!notice;\n+  const group = notice.group;\n+  if (!group) return statusTone.value !== 'settled' || undoVisible.value;\n+  if (groupStatusTone.value !== 'settled' || groupUndoVisible.value) return true;\n+  if (group.undone) return group.undone.compensationOutcomes.confirmed < group.undone.compensating;\n+  return group.counts.confirmed < group.count;\n+});\n+\n+const showActivity = computed(() => {\n+  if (!props.compact || !showNotice.value) return false;\n+  const group = props.notice?.group;\n+  if (!group) return statusTone.value === 'failed' || statusTone.value === 'unknown';\n+  if (group.acceptanceUnknown) return false;\n+  if (group.undone) {\n+    const outcomes = group.undone.compensationOutcomes;\n+    return outcomes.failed > 0 || outcomes.unknown > 0;\n+  }\n+  return groupUndoExpired.value && groupStatusTone.value !== 'pending' && groupStatusTone.value !== 'settled';\n+});\n+\n const undoExpired = computed(() => {\n   const status = props.notice?.operation?.status;\n   // Never after an undo: the original op row can stay `confirmed` while the\n@@ -273,13 +308,13 @@ const truncatedSubject = computed