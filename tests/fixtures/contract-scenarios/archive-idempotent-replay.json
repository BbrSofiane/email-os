{
  "scenario": "archive-idempotent-replay",
  "description": "Replaying the same request id returns the original receipt (same operation id and acceptance time even after the clock moved) and creates no second operation; the same id with a different payload is request_id_conflict.",
  "rules": "vertical-slice-01 durable receipts/dedup/conflict; docs/ux-04 \u00a73.3 (idempotent under requestId)",
  "profiles": [
    "gmail",
    "fixture"
  ],
  "mailbox": "triage",
  "steps": [
    {
      "name": "archive conv-01",
      "do": {
        "cmd": "setArchived",
        "args": {
          "conversation": "conv-01",
          "archived": true,
          "requestId": "req-1"
        }
      },
      "expect": {
        "ok": {
          "operationId": "$A",
          "acceptedAt": "@+0"
        },
        "snapshot": {
          "inbox": [
            "conv-05",
            "conv-04",
            "conv-03",
            "conv-02"
          ],
          "activity": [
            {
              "id": "$A",
              "conversation": {
                "conversationId": "conv-01"
              },
              "status": "confirmed",
              "failure": null,
              "undoOf": null,
              "groupId": null,
              "undoableUntil": "@+10",
              "requestedArchived": true
            }
          ]
        }
      }
    },
    {
      "name": "clock moves",
      "do": {
        "advance": 4
      },
      "expect": {}
    },
    {
      "name": "same request id replays",
      "do": {
        "cmd": "setArchived",
        "args": {
          "conversation": "conv-01",
          "archived": true,
          "requestId": "req-1"
        }
      },
      "expect": {
        "ok": {
          "operationId": "$A",
          "acceptedAt": "@+0"
        },
        "snapshot": {
          "inbox": [
            "conv-05",
            "conv-04",
            "conv-03",
            "conv-02"
          ],
          "activity": [
            {
              "id": "$A",
              "conversation": {
                "conversationId": "conv-01"
              },
              "status": "confirmed",
              "failure": null,
              "undoOf": null,
              "groupId": null,
              "undoableUntil": "@+10",
              "requestedArchived": true
            }
          ]
        }
      }
    },
    {
      "name": "same request id, different payload",
      "do": {
        "cmd": "setArchived",
        "args": {
          "conversation": "conv-01",
          "archived": false,
          "requestId": "req-1"
        }
      },
      "expect": {
        "error": {
          "kind": "request_id_conflict"
        }
      }
    },
    {
      "name": "same request id, different conversation",
      "do": {
        "cmd": "setArchived",
        "args": {
          "conversation": "conv-02",
          "archived": true,
          "requestId": "req-1"
        }
      },
      "expect": {
        "error": {
          "kind": "request_id_conflict"
        }
      }
    }
  ]
}
