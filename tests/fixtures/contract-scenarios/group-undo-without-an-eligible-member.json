{
  "scenario": "group-undo-without-an-eligible-member",
  "description": "A group whose every member is ineligible (rejected at acceptance, or definitely failed) advertises no undo availability; if the attempt is made anyway it is accepted as the group's one attempt with every member skipped (typed reasons), never as a restore.",
  "rules": "docs/ux-05 \u00a75 (an all-ineligible group offers no enabled Undo; skipped members persisted with reasons)",
  "profiles": [
    "gmail",
    "fixture"
  ],
  "mailbox": "triage",
  "steps": [
    {
      "name": "provider rejects the next call",
      "do": {
        "provider": "reject_next"
      },
      "expect": {}
    },
    {
      "name": "group of a missing and a failing member",
      "do": {
        "cmd": "setArchivedGroup",
        "args": {
          "members": [
            "ghost-1",
            "conv-01"
          ],
          "archived": true,
          "requestId": "grp-1"
        }
      },
      "expect": {
        "ok": {
          "groupId": "$G",
          "members": [
            {
              "ordinal": 0,
              "conversation": {
                "conversationId": "ghost-1"
              },
              "operationId": null,
              "rejection": "conversation_missing"
            },
            {
              "ordinal": 1,
              "conversation": {
                "conversationId": "conv-01"
              },
              "operationId": "$M1",
              "rejection": null
            }
          ]
        },
        "snapshot": {
          "inbox": [
            "conv-05",
            "conv-04",
            "conv-03",
            "conv-02",
            "conv-01"
          ],
          "activity": [
            {
              "id": "$M1",
              "conversation": {
                "conversationId": "conv-01"
              },
              "status": "failed",
              "failure": {
                "kind": "provider_rejected"
              },
              "undoOf": null,
              "groupId": "$G",
              "undoableUntil": null,
              "requestedArchived": true
            }
          ]
        }
      }
    },
    {
      "name": "group status offers no undo",
      "do": {
        "cmd": "getOperationGroup",
        "args": {
          "requestId": "grp-1"
        }
      },
      "expect": {
        "ok": {
          "undo": {
            "available": false,
            "reason": "not_applicable",
            "undoableUntil": null
          },
          "undoReceipt": null
        }
      }
    },
    {
      "name": "group undo skips every member",
      "do": {
        "cmd": "undoOperationGroup",
        "args": {
          "groupId": "$G",
          "requestId": "undo-1"
        }
      },
      "expect": {
        "ok": {
          "groupId": "$G",
          "members": [
            {
              "ordinal": 0,
              "decision": {
                "kind": "skipped",
                "reason": "acceptance_rejected"
              },
              "operationIds": []
            },
            {
              "ordinal": 1,
              "decision": {
                "kind": "skipped",
                "reason": "failed"
              },
              "operationIds": []
            }
          ]
        },
        "snapshot": {
          "inbox": [
            "conv-05",
            "conv-04",
            "conv-03",
            "conv-02",
            "conv-01"
          ],
          "activity": [
            {
              "id": "$M1",
              "conversation": {
                "conversationId": "conv-01"
              },
              "status": "failed",
              "failure": {
                "kind": "provider_rejected"
              },
              "undoOf": null,
              "groupId": "$G",
              "undoableUntil": null,
              "requestedArchived": true
            }
          ]
        }
      }
    }
  ]
}
