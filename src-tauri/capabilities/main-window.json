{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window only: approved named mail/search commands, UX-08 star commands, two UX-09 read-only provider-destination commands, UX-05 operation-group commands, local-draft commands, close-protocol commands, and the core event listener. No plugins, no shell, no broad capability grants.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-conversations",
    "allow-list-cached-done",
    "allow-list-cached-starred",
    "allow-set-starred",
    "allow-set-starred-group",
    "allow-get-saved-split",
    "allow-save-saved-split",
    "allow-search-mail",
    "allow-cancel-search-mail",
    "allow-list-provider-destinations",
    "allow-browse-provider-destination",
    "allow-get-conversation",
    "allow-set-archived",
    "allow-enable-mailbox-actions",
    "allow-cancel-mailbox-action-upgrade",
    "allow-set-read",
    "allow-retry-operation",
    "allow-undo-operation",
    "allow-set-archived-group",
    "allow-set-read-group",
    "allow-get-operation-group",
    "allow-list-operation-groups",
    "allow-undo-operation-group",
    "allow-get-account-status",
    "allow-connect-account",
    "allow-disconnect-account",
    "allow-request-sync",
    "allow-list-drafts",
    "allow-get-draft",
    "allow-create-draft",
    "allow-save-draft",
    "allow-delete-draft",
    "allow-get-app-close-request",
    "allow-complete-app-close",
    "allow-cancel-app-close"
  ]
}
